# Copy to .env and fill in. Values come from db/.env (created by db/provision_roles.py).
# App connects as ai_hub_app (DML only); Alembic connects as ai_hub_owner (DDL).

DATABASE__PROTOCOL=postgresql
DATABASE__HOST=imaginemore-playground-pg.postgres.database.azure.com
DATABASE__PORT=5432
DATABASE__USERNAME=ai_hub_app
DATABASE__PASSWORD=
DATABASE__NAME=ai-enablement-hub
DATABASE__SSL_MODE=require

# Owner-role URL used only by Alembic migrations (asyncpg driver, ssl=require).
# Integration tests also derive their connection from this URL, swapping the
# database name for ai-enablement-hub-test.
ALEMBIC_DATABASE_URL=postgresql+asyncpg://ai_hub_owner:<password>@imaginemore-playground-pg.postgres.database.azure.com:5432/ai-enablement-hub?ssl=require

# JWT signing secret (HS256). Generate with:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
AUTH__JWT_SECRET=

# Public frontend origin: CORS allow-origin AND the base for invite/reset links
# ({APP__URL}/invite/{token}). APP__ENV=dev additionally allows the localhost
# dev origins (3000, 5173). Defaults: http://localhost:5173 / dev.
APP__URL=http://localhost:5173
APP__ENV=dev

# Entra ID login (optional — leave all three unset to disable the feature;
# setting only some of them fails startup on purpose). Values come from the
# "AI Enablement Hub" app registration in the delaware tenant. The OAuth
# redirect URI is derived from APP__URL: {APP__URL}/api/auth/entra/callback.
# ENTRA__TENANT_ID=
# ENTRA__CLIENT_ID=
# ENTRA__CLIENT_SECRET=

# Invite/reset emails via Azure Communication Services (optional — leave both
# unset to disable; setting only one fails startup on purpose). Connection
# string of imaginemore-playground-acs (Azure portal → Keys); sender is a
# sender username on its linked email domain ("hub" has display name
# "AI Enablement Hub"). NOTE: enabling this locally sends REAL emails through
# the shared playground ACS resource.
# EMAIL__CONNECTION_STRING=endpoint=https://imaginemore-playground-acs.europe.communication.azure.com/;accesskey=<key>
# EMAIL__SENDER_ADDRESS=hub@c07b8f9c-80df-4e8a-9fb1-5671cfd049a5.azurecomm.net

# Lesson media (images/videos) via Azure Blob Storage (optional — leave
# CONNECTION_STRING unset to disable uploads; existing text/quiz/interactive
# lessons are unaffected). Connection string of the aienablementhubmedia
# storage account (Azure portal → Access keys). CONTAINER and SAS_TTL_HOURS
# are optional and default to "lesson-media" / 48 (must stay >= 25 — a SAS
# window quantized to midnight UTC must still cover a full day's fetch).
# NOTE: enabling this locally uploads to the REAL shared playground storage
# account, same caveat as the ACS email settings above.
# STORAGE__CONNECTION_STRING=DefaultEndpointsProtocol=https;AccountName=aienablementhubmedia;AccountKey=<key>;EndpointSuffix=core.windows.net
# STORAGE__CONTAINER=lesson-media
# STORAGE__SAS_TTL_HOURS=48
