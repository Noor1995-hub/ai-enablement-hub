{
  "name": "ai-enablement-hub-frontend",
  "private": true,
  "version": "0.0.1",
  "type": "module",
  "engines": {
    "node": "^22.12 || >=24"
  },
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "gen:api": "uv run --directory ../backend python scripts/export_openapi.py ../frontend/openapi.tmp.json && openapi-typescript openapi.tmp.json -o src/api/schema.d.ts && node -e \"require('fs').rmSync('openapi.tmp.json')\"",
    "lint": "eslint .",
    "typecheck": "tsc -b",
    "test": "vitest run"
  },
  "dependencies": {
    "@tanstack/react-query": "^5.103.2",
    "framer-motion": "^12.43.0",
    "openapi-fetch": "^0.17.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-router-dom": "^6.26.1"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "@testing-library/dom": "^10.4.2",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^4.3.4",
    "eslint": "^9.15.0",
    "eslint-plugin-react-hooks": "^5.0.0",
    "eslint-plugin-react-refresh": "^0.5.7",
    "globals": "^15.12.0",
    "jsdom": "^30.1.1",
    "openapi-typescript": "^7.4.3",
    "typescript": "~5.9.3",
    "typescript-eslint": "^8.70.1",
    "vite": "^6.0.0",
    "vitest": "^5.0.1"
  }
}
